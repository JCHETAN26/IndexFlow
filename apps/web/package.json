{
  "name": "@indexflow/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma": "prisma",
    "embed:backfill": "tsx --env-file=.env scripts/backfill-embeddings.ts",
    "es:backfill": "tsx --env-file=.env scripts/backfill-es.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "eval": "tsx --env-file=.env eval/run.ts",
    "eval:rag": "tsx --env-file=.env eval/rag-run.ts",
    "eval:depth": "tsx --env-file=.env eval/depth-matrix.ts",
    "eval:scale": "tsx --env-file=.env eval/scale-run.ts",
    "eval:trec-export": "tsx eval/trec-export.ts",
    "eval:crosscheck": "tsx eval/trec-export.ts && python3 eval/crosscheck.py .evalrun/trec",
    "eval:adversarial": "tsx --env-file=.env eval/adversarial-run.ts",
    "acl:leak": "tsx --env-file=.env eval/acl-leak.ts",
    "acl:dao": "tsx --env-file=.env eval/dao-check.ts",
    "consistency:check": "tsx --env-file=.env eval/consistency-check.ts",
    "test": "vitest run --dir test/unit",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:watch": "vitest --dir test/unit",
    "outbox:drain": "tsx --env-file=.env scripts/outbox-drain.ts",
    "reconcile": "tsx --env-file=.env scripts/reconcile.ts",
    "acl:sharing": "tsx --env-file=.env eval/sharing-check.ts",
    "bench:latency": "tsx --env-file=.env bench/latency-bench.ts",
    "worker": "tsx --env-file=.env worker/index.ts",
    "smoke:deploy": "tsx --env-file=.env scripts/smoke.ts",
    "retention:cleanup": "tsx --env-file=.env scripts/retention-cleanup.ts",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "judge:export": "tsx --env-file=.env eval/export-labels.ts",
    "judge:calibrate": "tsx --env-file=.env eval/calibrate-judges.ts",
    "eval:embed-shard": "tsx --env-file=.env eval/embed-shard.ts",
    "eval:scale-curve": "tsx --env-file=.env eval/scale-curve.ts",
    "bench:ingest": "tsx --env-file=.env bench/ingest-bench.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1077.0",
    "@elastic/elasticsearch": "^8.19.2",
    "@huggingface/transformers": "^4.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.79.2",
    "next": "^15.1.4",
    "next-auth": "5.0.0-beta.31",
    "ollama": "^0.6.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^1.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
