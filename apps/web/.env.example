# Postgres (matches infra/docker-compose.yml)
DATABASE_URL="postgresql://indexflow:indexflow@localhost:5440/indexflow?schema=public"

# MinIO object storage (matches infra/docker-compose.yml)
MINIO_ENDPOINT="http://localhost:9100"
MINIO_ACCESS_KEY="indexflow"
MINIO_SECRET_KEY="indexflow123"
MINIO_BUCKET="indexflow"

# Redis / BullMQ (matches infra/docker-compose.yml)
REDIS_URL="redis://localhost:6380"

# Elasticsearch keyword index (matches infra/docker-compose.yml)
ES_URL="http://localhost:9200"
# ES_INDEX="indexflow_chunks"  # optional override; defaults to indexflow_chunks

# Auth.js (NextAuth) — identity / sign-in.
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=""
# Google OAuth client (console.cloud.google.com → Credentials → OAuth client, Web app).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: OpenAI embedding provider (unused — embeddings run locally via Transformers.js)
OPENAI_API_KEY=""

# Seed script authentication. Uploading requires a signed-in user; `pnpm seed` has no browser
# session, so it presents this shared secret instead and its documents are owned by the demo
# user and marked public. Must be 16+ chars. Generate: openssl rand -base64 24
SEED_TOKEN=""

# ── Public demo deployment (all OFF by default; a normal deployment sets none of these) ──
# DEMO_MODE=1     Read-only public demo: upload/delete/sharing refuse with 403, and /api/answer
#                 returns real retrieved citations plus an explanation instead of generating
#                 (the host has no Ollama). Implies ALLOW_GUEST.
# ALLOW_GUEST=1   Offer "Continue as guest" on /signin — one shared, pre-seeded read-only
#                 identity, so visitors need no Google account. Leave unset for a private
#                 deployment; otherwise anyone can obtain a session.
# DEMO_USER_EMAIL="guest@indexflow.demo"   Identity guests share and the seed corpus is owned by.

# ── Rate limits (defaults shown; all optional) ──
# Per-caller limits, keyed by user id when signed in, else client IP. State is in-memory, so
# limits are PER PROCESS and reset on restart — enough for a single-container demo, not a
# substitute for edge/WAF rate limiting. The expensive eval endpoints are additionally capped to
# one concurrent run each, globally, which is what actually protects the host.
# RL_SEARCH_PER_MIN=30
# RL_ANSWER_PER_MIN=10
# RL_UPLOAD_PER_HOUR=20
# RL_EVAL_PER_10MIN=3        # /api/eval — seeds + embeds a corpus per call
# RL_EVAL_RAG_PER_HOUR=1     # /api/eval/rag — ~30 min of local LLM work; 503s when DEMO_MODE=1

# Ollama (local LLMs) — Stage B: grounded RAG answers + LLM-as-judge eval.
# No API key: install Ollama (https://ollama.com) and pull the models below, e.g.
#   ollama pull llama3.2:3b && ollama pull qwen2.5:7b && ollama pull bespoke-minicheck
# OLLAMA_HOST="http://127.0.0.1:11434"   # default; only set to point at a remote server
# Optional model overrides (defaults shown):
# RAG_MODEL="llama3.2:3b"                # answer generation
# JUDGE_MODEL="qwen2.5:7b"               # judges answer relevance + citation correctness
# FAITHFULNESS_MODEL="bespoke-minicheck" # per-claim grounded-factuality checker
#   Generation and judges are different models, so there's no self-preference bias.
