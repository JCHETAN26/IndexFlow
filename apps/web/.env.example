# Postgres (matches infra/docker-compose.yml)
DATABASE_URL="postgresql://indexflow:indexflow@localhost:5440/indexflow?schema=public"

# MinIO object storage (matches infra/docker-compose.yml)
MINIO_ENDPOINT="http://localhost:9100"
MINIO_ACCESS_KEY="indexflow"
MINIO_SECRET_KEY="indexflow123"
MINIO_BUCKET="indexflow"

# Redis / BullMQ (matches infra/docker-compose.yml)
REDIS_URL="redis://localhost:6380"

# Elasticsearch keyword index (matches infra/docker-compose.yml)
ES_URL="http://localhost:9200"
# ES_INDEX="indexflow_chunks"  # optional override; defaults to indexflow_chunks

# Auth.js (NextAuth) — identity / sign-in.
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=""
# Google OAuth client (console.cloud.google.com → Credentials → OAuth client, Web app).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: OpenAI embedding provider (unused — embeddings run locally via Transformers.js)
OPENAI_API_KEY=""
